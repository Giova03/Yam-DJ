# =====================================================================
# YAM DJ V1 — Configuration Backend (copier vers .env puis remplir)
#   cp .env.example .env
# SECURITE : ne JAMAIS commiter le fichier .env (il est gitignore).
# =====================================================================

# --- Base de donnees Supabase (PostgreSQL) ---
# Dashboard Supabase > Project Settings > Database > Connection string
# /!\ db.xxx.supabase.co est IPv6-only. Sur un hebergeur IPv4 (Render...),
# preferer le pooler "Session mode" (port 5432). VIA LE POOLER, l'utilisateur
# est "postgres.<project-ref>" (ex : postgres.abcdefghijkl123456) :
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# DB_HOST=db.votre-projet.supabase.co   (si IPv6 disponible, user = postgres)
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.votre-project-ref
DB_PASSWORD=votre-mot-de-passe-supabase

# --- JWT (generer avec : openssl rand -base64 48) ---
JWT_SECRET=generer-une-cle-aleatoire-de-48-octets-en-base64
JWT_EXPIRATION=86400000

# --- Cloudflare R2 (stockage audio/images) ---
# Dashboard Cloudflare > R2 > Manage API Tokens > Access Key ID + Secret
# Account ID : Dashboard Cloudflare (accueil, a droite) ou API /accounts
R2_ACCOUNT_ID=votre-account-id-cloudflare
R2_ACCESS_KEY=votre-access-key-id-r2
R2_SECRET_KEY=votre-secret-access-key-r2
R2_BUCKET=yam-dj-media
# Apres activation de l'acces public : R2 > bucket > Settings > Public access
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# --- CinetPay (Orange Money / Moov Money — Tips artistes) ---
# Dashboard CinetPay > Integration : API Key (pk_live...) + Site ID (numerique)
CINETPAY_API_KEY=pk_live_votre-cle-api-cinetpay
CINETPAY_SITE_ID=votre-site-id-numerique
CINETPAY_SECRET_KEY=sk_live_votre-cle-secrete-cinetpay
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2

# --- Brevo (emails transactionnels — 300/jour gratuits) ---
# Si BREVO_API_KEY est vide, les emails passent en mode MOCK (logs backend)
BREVO_API_KEY=
BREVO_SENDER=no-reply@yamdj.africa
BREVO_SENDER_NAME="YAM DJ"

# --- Application ---
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:4200,https://yam-dj.vercel.app
APP_BASE_URL=http://localhost:8080

# --- FFmpeg (conversion HLS 128k / 48k) ---
FFMPEG_PATH=ffmpeg
