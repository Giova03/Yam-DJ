# =====================================================================
# YAM DJ V1 — Configuration Backend (copier vers .env puis remplir)
#   cp .env.example .env
# SECURITE : ne JAMAIS commiter le fichier .env (il est gitignore).
# =====================================================================

# --- Base de donnees Supabase (PostgreSQL) ---
# Dashboard Supabase > Project Settings > Database > Connection string
# /!\ db.xxx.supabase.co est IPv6-only. Sur un hebergeur IPv4 (Render...),
# preferer le pooler "Session mode" (port 5432). VIA LE POOLER, l'utilisateur
# est "postgres.<project-ref>" (ex : postgres.abcdefghijkl123456) :
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# DB_HOST=db.votre-projet.supabase.co   (si IPv6 disponible, user = postgres)
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.votre-project-ref
DB_PASSWORD=votre-mot-de-passe-supabase

# --- JWT (generer avec : openssl rand -base64 48) ---
JWT_SECRET=generer-une-cle-aleatoire-de-48-octets-en-base64
JWT_EXPIRATION=86400000

# --- Supabase Storage (medias : HLS, pochettes, mixtapes) ---
# Dashboard Supabase > Settings > API : URL du projet + cle service_role (secret)
# Bucket "media" (public, 50 Mo/fichier). Si la cle est vide, mode local
# de secours automatique (dossier ./yam-media, servi via /media/**).
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_KEY=votre-cle-service-role-supabase
SUPABASE_STORAGE_BUCKET=media

# --- FedaPay (Orange Money / Moov / MTN / Wave — Tips artistes) ---
# Dashboard FedaPay > Developpeurs > Cles API
# Webhook a declarer : https://votre-backend.onrender.com/api/webhook/fedapay
FEDAPAY_PUBLIC_KEY=pk_live_votre-cle-publique-fedapay
FEDAPAY_SECRET_KEY=sk_live_votre-cle-secrete-fedapay
FEDAPAY_BASE_URL=https://api.fedapay.com

# --- Brevo (emails transactionnels — 300/jour gratuits) ---
# Si BREVO_API_KEY est vide, les emails passent en mode MOCK (logs backend)
# /!\ BREVO_SENDER doit etre un expediteur VERIFIE sur le compte Brevo
# (dashboard Brevo > Senders) sinon Gmail rejette les emails en silence.
BREVO_API_KEY=
BREVO_SENDER=expediteur-verifie@exemple.com
BREVO_SENDER_NAME="YAM DJ"

# --- Application ---
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:4200,https://yam-dj.vercel.app,https://yam-dj-frontend.vercel.app
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4200

# --- FFmpeg (conversion HLS 128k / 48k) ---
FFMPEG_PATH=ffmpeg

# --- Connexion Google (OAuth 2.0) ---
# Google Cloud Console -> API et services -> Identifiants -> Creer des
# identifiants -> ID client OAuth -> type "Application Web".
# URI de redirection autorisee a enregistrer chez Google :
# https://yam-dj.onrender.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optionnel : force l'URI de redirection (defaut = APP_BASE_URL + /api/auth/oauth/google/callback)
GOOGLE_REDIRECT_URI=

# Moderation : true = publication immediate des uploads (defaut, recommande
# en lancement) ; false = file stricte (PENDING -> validation dans /admin).
YAMDJ_MODERATION_AUTO_APPROVE=true
