# =====================================================================
# YAM DJ V1 — Configuration Frontend (copier vers .env)
#   cp .env.example .env
# ng serve lit automatiquement NG_APP_* au demarrage
# =====================================================================

# API backend (local ou production Render)
NG_APP_API_URL=http://localhost:8080
# En production (Render) :
# NG_APP_API_URL=https://yam-dj-backend.onrender.com

# WebSocket
NG_APP_WS_URL=http://localhost:8080/ws

# CinetPay (paiement Orange Money) — Site ID numerique du dashboard
NG_APP_CINETPAY_SITE_ID=votre-site-id-cinetpay
